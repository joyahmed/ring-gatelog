RING_TOKEN=
RING_MODE=replay
RING_API_BASE=https://api.amazonvision.com
GATE_TZ=Asia/Dhaka
# Required in production: HMAC secret for Ring webhook signatures
RING_WEBHOOK_SECRET=
# Required in production: sent as x-sync-key to POST /api/ring/sync
SYNC_KEY=
# Set to 1 only to accept unsigned webhooks in production
GATELOG_ALLOW_UNSIGNED=
